# Copy this file to credentials.pkrvars.hcl and fill in the password.
# credentials.pkrvars.hcl is gitignored (.gitignore: packer/*.pkrvars.hcl) —
# it is the only file in this directory that is allowed to hold a secret.
#
#   cp credentials.pkrvars.hcl.example credentials.pkrvars.hcl
#   $EDITOR credentials.pkrvars.hcl
#   packer build -var-file=credentials.pkrvars.hcl .
#
# If you would rather not have the password on disk at all, skip the file and
# export it instead:
#
#   read -rs PKR_VAR_vsphere_password && export PKR_VAR_vsphere_password
#   packer build .

# ── The one required value ─────────────────────────────────────────────────
vsphere_password = "CHANGEME"

# ── Everything below already defaults to these values in variables.pkr.hcl.
#    Uncomment only what you need to override. ───────────────────────────────

# vsphere_server     = "vcsa.oberin.cloud"
# vsphere_user       = "matej@oberin.cloud"
# vsphere_datacenter = "Datacenter"
# vsphere_host       = "esxi.oberin.cloud"
# vsphere_datastore  = "NVMe"
# vsphere_network    = "Internet_10.0.0.0"
# vsphere_folder     = "Templates"

# Terraform looks the template up by this exact name — see
# terraform/terraform.tfvars, ubuntu_template.
# template_name = "ubuntu-24.04-template"

# Must stay <= 40 GB (40960): the etcd nodes clone with disk_size = 40 and a
# clone can grow a disk but never shrink one.
# template_disk_size = 20480

# ssh_username         = "ansible"
# ssh_private_key_file = "~/.ssh/id_rsa"
# ssh_public_key       = "ssh-rsa AAAA... user@host"
