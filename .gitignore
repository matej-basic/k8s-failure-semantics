# --- Claude Code ---
# CLAUDE.md is tracked - it documents project conventions
.claude/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
tfplan
*.tfplan

# --- Packer ---
# The vCenter password lives in packer/credentials.pkrvars.hcl; the .example
# alongside it carries only a placeholder and is tracked deliberately.
packer/*.pkrvars.hcl
packer/*.pkrvars.hcl.json
packer/packer_cache/
packer/*.log
packer/packer-manifest.json
packer/*manifest.json

# --- Ansible ---
*.retry
.vault_pass
vault_pass.txt
.ansible/

